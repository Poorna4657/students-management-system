# MongoDB Connection URI (Local or MongoDB Atlas cluster)
# Local example: mongodb://localhost:27017
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGODB_URI=mongodb://localhost:27017

# Database Name
DB_NAME=student_management

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# Allowed CORS Origins (comma separated, or * for all)
# Example: https://my-student-app.vercel.app,http://localhost:5173
CORS_ORIGIN=*
